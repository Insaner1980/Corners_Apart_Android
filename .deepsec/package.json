{
  "private": true,
  "type": "module",
  "scripts": {
    "deepsec": "deepsec",
    "deepsec:scan": "deepsec scan --project-id corners_apart_android",
    "deepsec:scan:custom": "deepsec scan --project-id corners_apart_android --matchers android-exported-component,fileprovider-broad-path,android-uri-share-without-clipdata,raw-nearby-bypass,sensitive-android-log",
    "deepsec:process": "deepsec process --project-id corners_apart_android",
    "deepsec:revalidate": "deepsec revalidate --project-id corners_apart_android --min-severity HIGH",
    "deepsec:export": "deepsec export --project-id corners_apart_android --format md-dir --out ./findings",
    "deepsec:report": "pnpm run deepsec:scan && pnpm run deepsec:process && pnpm run deepsec:export",
    "deepsec:report:custom": "pnpm run deepsec:scan:custom && pnpm run deepsec:process && pnpm run deepsec:export"
  },
  "dependencies": {
    "deepsec": "2.0.12"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "typescript": "6.0.3"
  }
}
